# ---- پایگاه داده (PostgreSQL) ----
# رشته‌ی اتصال Drizzle/pg
DATABASE_URL="postgresql://user:password@localhost:5432/qafaseh"

# ---- استقرار production ----
# مسیر persistent برای dump پیش از migration. در Coolify یک volume پایدار روی
# همین مسیر mount کنید؛ کانتینر در صورت شکست backup یا migration بالا نمی‌آید.
DATABASE_BACKUP_DIR="/app/backups"
# اختیاری اما توصیه‌شده: هویت بدون رمز دیتابیس برای fail-closed شدن deploy.
# نمونه: db.example.com:5432/qafaseh?sslmode=require
EXPECTED_DATABASE_TARGET=""
# اختیاری: SHA-256 کامل DATABASE_URL، فقط در secret manager نگهداری شود.
EXPECTED_DATABASE_FINGERPRINT=""
# فقط برای اجرای یک‌باره‌ی baseline در Coolify: true؛ سپس حذف شود.
RUN_MIGRATION_BASELINE="false"
# baseline علاوه بر RUN_MIGRATION_BASELINE به این تأیید صریح نیاز دارد.
ALLOW_MIGRATION_BASELINE="false"
# اجرای گزارش فقط-خواندنی migration پیش از preflight؛ هرگز ledger/schema را تغییر نمی‌دهد.
RUN_MIGRATION_AUDIT_ONCE="false"
# گزارش کامل audit در deployment logs (بدون URL/fingerprint/secret).
RUN_MIGRATION_AUDIT_LOG_SUMMARY="false"
# فقط برای بازیابی یک‌باره‌ی ledger خالی در schema موجود؛ هر دو flag و target/fingerprint لازم‌اند.
RUN_MIGRATION_LEDGER_REPAIR="false"
ALLOW_MIGRATION_LEDGER_REPAIR="false"
# audited final recovery: records only 0000-0037, then Drizzle runs 0038.
RUN_MIGRATION_LEDGER_FINAL_REPAIR="false"
ALLOW_MIGRATION_LEDGER_FINAL_REPAIR="false"

# ---- احراز هویت ----
# کلید امضای JWT — یک مقدار تصادفی و امن (حداقل ۳۲ کاراکتر).
# تولید نمونه:  openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-secret-value"
# Temporary workaround for the unavailable email-code service. Keep disabled
# so password registration and login never wait for an email OTP. Set to true
# only when the email-code provider has been restored and email verification
# should be required again.
NEXT_PUBLIC_EMAIL_OTP_ENABLED="false"

# ---- ادمین ----
# ایمیل‌هایی که به‌صورت خودکار دسترسی ادمین دارند (با کاما جدا شوند).
# برای راه‌اندازی اولین ادمین بدون ویرایش مستقیم دیتابیس کاربرد دارد.
# جایگزین/مکمل: ستون role=ADMIN روی کاربر در دیتابیس.
ADMIN_EMAILS="you@example.com"

# ---- آدرس اپ ----
# آدرس نهایی پروداکشن. این مقدار مبنای canonical URL، sitemap، OpenGraph و لینک‌های ایمیل است.
APP_URL="http://localhost:3000"
# برای استفاده‌ی کلاینت‌ساید در صورت نیاز
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# سازگاری با کدهای قدیمی‌تر متادیتا
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
PORT="3005"

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# در production مقدار دقیق ثبت‌شده در Google Console را وارد کنید.
# در development خالی باشد از NEXT_PUBLIC_APP_URL یا origin درخواست استفاده می‌شود.
GOOGLE_REDIRECT_URI=""
# فقط برای تشخیص موقت redirect_uri؛ هرگز توکن یا secret لاگ نمی‌شود.
GOOGLE_OAUTH_DEBUG="false"

# ---- آپلود و ذخیره‌سازی ----
# توسعه به‌صورت پیش‌فرض local است؛ این مقدار را فقط برای صراحت نگه دارید.
# local فقط در توسعه کاربرد دارد؛ در production همیشه S3 استفاده می‌شود.
UPLOAD_DRIVER="local"
# fallback محلی فقط در توسعه فعال است و در production نادیده گرفته می‌شود.
UPLOAD_LOCAL_FALLBACK="true"
# محدودیت حجم فایل آپلودی بر حسب کیلوبایت
UPLOAD_MAX_FILE_KB="500"

# ---- S3 / Arvan Object Storage ----
# در production آپلود همیشه S3 است؛ local فقط برای توسعه قابل استفاده است.
# این نام‌ها دقیق‌اند؛ متغیرهای ترکیب‌شده/غلط مانند
# S3_SECRET_ACCESS_KEYS3_PUBLIC_BASE_URL خوانده نمی‌شوند.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
# اختیاری است (برای Arvan مقدار پیش‌فرض auto استفاده می‌شود).
S3_REGION=""

# ---- ایمیل (Mailerino SMTP) ----
# رمز عبور را فقط در محیط اجرا/Coolify وارد کنید؛ هرگز آن را commit نکنید.
SMTP_HOST="smtp.maileronline.com"
SMTP_PORT="587"
SMTP_USER="varmanliamirhosein@gmail.com"
SMTP_PASSWORD=""
MAIL_FROM="noreply@qafasehman.ir"
# فقط برای توسعه محلی بدون SMTP: ارسال را رد می‌کند و کد در پاسخ توسعه برمی‌گردد.
EMAIL_MODE="dev"
EMAIL_DEV_MODE="true"

# ---- اختیاری / دیباگ ----
DEBUG_LIBRARY_ROUTE="0"

# ---- IranKetab Discovery worker / cron ----
# Automatic background scrapers and cron discovery are disabled by default.
# Set ENABLE_AUTO_IMPORTER="true" only if automatic background discovery is explicitly desired.
ENABLE_AUTO_IMPORTER="false"
# Required when automatic discovery/import is enabled. Generate a distinct,
# high-entropy secret and call POST /api/internal/iranketab-discovery/tick with
# Authorization: Bearer <secret> every minute from the deployment scheduler.
IRANKETAB_DISCOVERY_WORKER_SECRET=""
# ID of an existing administrator. It is used only for importer ownership/audit.
IRANKETAB_DISCOVERY_WORKER_ACTOR_ID=""
# Safety bounds per cron invocation.
IRANKETAB_DISCOVERY_WORKER_BATCH_SIZE="10"
IRANKETAB_DISCOVERY_SCHEDULER_SOURCE_BATCH_SIZE="10"
# Concurrency limit for cover preparation (strictly set to 1 for manual execution).
IRANKETAB_COVER_PREPARATION_CONCURRENCY="1"
